{
  "name": "Gaming",
  "style": "bold-neon",
  "description": "Gaming website: dark backgrounds, neon accents, aggressive typography, particle effects, high energy",
  "colors": {
    "primary": "#00FF88",
    "secondary": "#7B2FFF",
    "accent": "#FF2D55",
    "background": "#0A0A0F",
    "surface": "#151520",
    "surface-elevated": "#1E1E2E",
    "text-primary": "#FFFFFF",
    "text-secondary": "rgba(255,255,255,0.6)",
    "neon-glow": "0 0 20px rgba(0,255,136,0.3)",
    "border": "rgba(255,255,255,0.06)"
  },
  "typography": {
    "heading": "'Orbitron', 'Rajdhani', sans-serif",
    "body": "'Rajdhani', 'Inter', sans-serif",
    "headingWeight": "700",
    "bodyWeight": "400",
    "headingSizes": ["72px", "48px", "36px", "24px"],
    "bodySizes": ["18px", "16px", "14px"],
    "lineHeight": "1.3",
    "letterSpacing": "2px",
    "textTransform": "uppercase"
  },
  "spacing": {
    "base": "8px",
    "scale": ["4px", "8px", "16px", "24px", "32px", "48px", "64px", "96px"],
    "containerMaxWidth": "1400px",
    "sectionPadding": "80px 0",
    "cardPadding": "24px"
  },
  "layout": {
    "grid": "12-column",
    "gap": "20px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1440px" },
    "centered": true
  },
  "components": {
    "borderRadius": "4px",
    "borderRadiusLg": "8px",
    "shadow": "0 0 30px rgba(0,255,136,0.1)",
    "shadowHover": "0 0 40px rgba(0,255,136,0.2), 0 0 80px rgba(123,47,255,0.1)",
    "navHeight": "64px",
    "navBg": "rgba(10,10,15,0.9)",
    "navBlur": "blur(16px)",
    "buttonRadius": "4px",
    "buttonPadding": "14px 32px",
    "clipPath": "polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%)"
  },
  "animation": {
    "style": "glitch-energy",
    "duration": "0.3s",
    "easing": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "glitch": true,
    "particleEffects": true,
    "entrance": "slide-glitch",
    "transition": "all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)"
  }
}
