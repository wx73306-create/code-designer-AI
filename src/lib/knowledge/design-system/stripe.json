{
  "name": "Stripe",
  "style": "vibrant-gradient",
  "description": "Stripe's design language: bold gradients, mesh backgrounds, clean cards, developer-friendly",
  "colors": {
    "primary": "#635BFF",
    "secondary": "#0A2540",
    "accent": "#00D4FF",
    "background": "#FFFFFF",
    "surface": "#F6F9FC",
    "text-primary": "#0A2540",
    "text-secondary": "#425466",
    "border": "#E3E8EE",
    "gradient-start": "#635BFF",
    "gradient-end": "#00D4FF"
  },
  "typography": {
    "heading": "'Sohne', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "body": "'Sohne', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "headingWeight": "700",
    "bodyWeight": "400",
    "headingSizes": ["64px", "48px", "36px", "28px", "20px"],
    "bodySizes": ["18px", "16px", "14px"],
    "lineHeight": "1.5"
  },
  "spacing": {
    "base": "8px",
    "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "96px"],
    "containerMaxWidth": "1080px",
    "sectionPadding": "96px 0",
    "cardPadding": "32px"
  },
  "layout": {
    "grid": "12-column",
    "gap": "24px",
    "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
    "centered": true
  },
  "components": {
    "borderRadius": "8px",
    "borderRadiusLg": "16px",
    "shadow": "0 2px 8px rgba(0,0,0,0.06), 0 8px 24px rgba(0,0,0,0.06)",
    "shadowHover": "0 4px 12px rgba(0,0,0,0.1), 0 16px 40px rgba(0,0,0,0.1)",
    "navHeight": "72px",
    "navBg": "rgba(255,255,255,0.95)",
    "buttonRadius": "6px",
    "buttonPadding": "12px 20px"
  },
  "animation": {
    "style": "gradient-shift",
    "duration": "0.4s",
    "easing": "cubic-bezier(0.23, 1, 0.32, 1)",
    "hoverTranslateY": "-4px",
    "entrance": "fade-slide-up",
    "transition": "all 0.4s cubic-bezier(0.23, 1, 0.32, 1)"
  }
}
