{
  "name": "Apple",
  "style": "premium-minimal",
  "description": "Apple's design language: extreme minimalism, generous whitespace, precise typography, subtle animations",
  "colors": {
    "primary": "#0071E3",
    "secondary": "#1D1D1F",
    "accent": "#FF375F",
    "background": "#FFFFFF",
    "surface": "#F5F5F7",
    "text-primary": "#1D1D1F",
    "text-secondary": "#6E6E73",
    "border": "rgba(0,0,0,0.08)"
  },
  "typography": {
    "heading": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif",
    "body": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif",
    "headingWeight": "600",
    "bodyWeight": "400",
    "headingSizes": ["56px", "48px", "40px", "32px", "24px"],
    "bodySizes": ["21px", "17px", "14px", "12px"],
    "lineHeight": "1.47"
  },
  "spacing": {
    "base": "4px",
    "scale": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "80px", "120px"],
    "containerMaxWidth": "980px",
    "sectionPadding": "80px 0",
    "cardPadding": "24px"
  },
  "layout": {
    "grid": "12-column",
    "gap": "24px",
    "breakpoints": { "sm": "734px", "md": "1068px", "lg": "1440px" },
    "centered": true
  },
  "components": {
    "borderRadius": "12px",
    "borderRadiusLg": "18px",
    "shadow": "0 4px 24px rgba(0,0,0,0.08)",
    "shadowHover": "0 12px 40px rgba(0,0,0,0.12)",
    "navHeight": "44px",
    "navBlur": "blur(20px) saturate(1.8)",
    "navBg": "rgba(255,255,255,0.72)",
    "buttonRadius": "980px",
    "buttonPadding": "12px 24px"
  },
  "animation": {
    "style": "scroll-reveal",
    "duration": "0.6s",
    "easing": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "hoverScale": "1.02",
    "entrance": "fade-up",
    "transition": "all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)"
  }
}
