# ============================================================================
# Code Designer AI — 环境变量模板
# 复制为 .env 并填入真实值。生产环境务必更换所有默认密钥。
# ============================================================================

# --- 数据库（PostgreSQL）---
# 本地: postgresql://user:password@localhost:5432/code_designer_ai
# 云端(Supabase/Neon/Railway): 粘贴控制台给的连接串
DATABASE_URL="postgresql://user:password@localhost:5432/code_designer_ai"

# --- Redis（BullMQ 任务队列 + 可选缓存）---
# 本地: redis://localhost:6379
# 云端(Upstash/Redis Cloud): 粘贴连接串
REDIS_URL="redis://localhost:6379"

# --- Auth.js（NextAuth v5）---
# 生成: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
AUTH_URL="http://localhost:3000"
# 反向代理/容器部署时设为 true
AUTH_TRUST_HOST="true"

# --- 管理后台会话 ---
# 管理员登录凭据（生产必须更换）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_admin_password"
# 会话签名密钥（生产必须更换）: openssl rand -base64 32
ADMIN_SESSION_SECRET="replace-with-a-random-secret"

# --- AI 模型 ---
# 阿里云百炼（推荐，主要模型）
ALIBABA_API_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
ALIBABA_API_KEY=""
# MiMo（可选）
MIMO_API_URL="https://api.xiaomimimo.com/v1"
MIMO_API_KEY=""
MIMO_MODEL="mimo-v2.5"
# 其他厂商（可选，BYOK）
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# --- 邮件服务（密码找回）---
# 方式一: SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@codedesigner.ai"
# 方式二: Resend
RESEND_API_KEY=""

# --- 部署（真实部署用）---
VERCEL_TOKEN=""
GITHUB_TOKEN=""

# --- 还原度度量（Phase 2 / Sprint B，默认关闭）---
# RECONSTRUCTION_DIFF=on 后每次生成会多一次生成页渲染（~3s），
# 并在 QAResult 上新增 reconstructionScore 字段。详见 docs/phase2-sprintB-reconstruction-diff-design.md
RECONSTRUCTION_DIFF=""

# --- 工作区运行模式徽章（B.2.3.2）---
# true  → 页头显示「演示模式」，声明全链路为模拟数据（展示/演示环境用）
# false → 徽章由真实运行状态决定：「示例数据」（尚未跑过生成，各区块吃 mock 兜底）
#         或「AI 分析模式」（本任务真实执行过）
# 注意：NEXT_PUBLIC_* 是**构建期内联**的，运行时注入无效 —— Docker 里需经
# docker-compose.yml 的 build.args 传入并重建镜像；改完必须重新 build。
NEXT_PUBLIC_DEMO_MODE="false"
